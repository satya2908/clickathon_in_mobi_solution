# Copy to .env and fill in. Never commit .env -- it holds credentials.
#
# Every variable here maps to a ${PLACEHOLDER} in config/verdict.yaml. The split is
# deliberate: the YAML describes behaviour and is safe to commit or mount as a ConfigMap,
# while this file holds only secrets and per-environment endpoints.

# ---- ClickHouse Cloud (required) ----------------------------------------------------------
# From the Cloud console: Connect -> HTTPS. Host has no protocol and no port.
CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=verdict
CLICKHOUSE_SECURE=true

# ---- LLM (optional) -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Narration is the only thing the model does; set
# LLM_ENABLED=false and every computed number in every case file is identical, with prose
# falling back to a template. The same key also drives the chat surface, so it goes here once.
#
# Defaults below target Google AI Studio, whose free tier needs no card: get a key at
# https://ai.google.dev. Gemini is reached over its OpenAI-compatible path rather than the
# native Google API so that this file, the pipeline client and LibreChat all speak one wire
# format -- moving to Groq or OpenAI is a change of URL and model, nothing more.
LLM_ENABLED=true
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# Reasoning models bill hidden thinking against max_tokens without it appearing in the response.
# Measured on Gemini Flash: 110 thinking tokens for a seven-token reply, and at the old 1200
# ceiling a full case narration stopped mid-sentence. Raising the budget and lowering the effort
# both help; the client now refuses a truncated draft outright rather than publishing half a
# paragraph, since the numeric verifier only checks figures and a cut sentence has none wrong.
# Leave LLM_REASONING_EFFORT blank for providers that reject the parameter.
LLM_MAX_TOKENS=3000
LLM_REASONING_EFFORT=low

# ---- Tracing ------------------------------------------------------------------------------
# Left unset, the app exports to the ClickStack container started by docker compose.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=verdict
HYPERDX_API_KEY=

# ---- Console (web) ----
# Read in the browser, so anything here is public by definition. Never put a credential in a
# NEXT_PUBLIC_ variable: the ClickHouse connection above stays server-side, where it is used
# during render and never reaches the client.
#
# HyperDX: the hosted instance that ships with ClickHouse Cloud, which is where the OTLP
# collector sends traces. Point this at http://localhost:8080 instead when running the
# self-hosted ClickStack container (`docker compose --profile selfhosted up -d`).
NEXT_PUBLIC_HYPERDX_URL=https://hyperdx.clickhouse.cloud
# Only needed if the HyperDX deployment has several trace sources and picks the wrong one.
NEXT_PUBLIC_HYPERDX_SOURCE=
# Verdict.AI, the chat bubble embedded in the console.
NEXT_PUBLIC_CHAT_URL=http://localhost:3080

# ---- Paths --------------------------------------------------------------------------------
# Where ad_events.parquet and the three dimension CSVs live on the host. Mounted read-only at
# /data in the engine container, which is also the only place the ingest control below will
# accept a path from.
DATA_DIR=../hackathon_dataaset/InMobi/data

# ---- Ingest from the console (optional) ---------------------------------------------------
# Adds an "Ingest release" control to the toolbar: type the path of a new release and the
# console runs the same `verdict ingest` a terminal would, then offers to reload.
#
# Off by default because it runs a program against a path the browser supplied. The engine
# resolves that path against /data and refuses anything outside it, symlinks included, but the
# safe default for a control like this is still off.
#
# Under Compose, leave the URL alone: the endpoint has no host port and is reachable only from
# the web container. Running `npm run dev` on the host instead, clear it -- with no URL set the
# console runs the local CLI directly and VERDICT_INGEST_ROOT decides what it may touch.
INGEST_ENABLED=false
VERDICT_INGEST_URL=http://verdict:8158
# Mounted read-only at /releases. A path typed into the console is resolved against this and
# anything outside it is refused, symlinks followed first. Defaults to the parent of the repo, so
# a release unpacked beside the checkout is reachable as /releases/<name>.
RELEASES_DIR=..
# VERDICT_BIN=./.venv/bin/verdict
# VERDICT_INGEST_ROOT=..

# ---- Retention ----------------------------------------------------------------------------
# Leave false when analysing a historical dataset. Turning it on applies a 7-day TTL to raw
# events, which for data older than a week means ClickHouse correctly deletes all of it.
RETENTION_ENFORCE=false

# ---- Ports (host side) --------------------------------------------------------------------
HYPERDX_UI_PORT=8080
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317

# ---- Cursor CLI recommendations (optional) -----------------------------------------------
# `./stack.sh up` leaves this capability disabled and does not build the Cursor image.
# `./stack.sh up --with-ai` validates CURSOR_API_KEY, starts the profile, and enables the
# server-side UI/API gate. The browser toggle still starts off to avoid accidental model spend.
RECOMMENDATIONS_ENABLED=false
CURSOR_API_KEY=

# Optional defense in depth for /v1/*. This value stays server-side: Compose gives the same token
# to the Next.js server and the private Cursor service, never to browser JavaScript.
CURSOR_SERVICE_API_TOKEN=

# The bundled defaults can be overridden for models available to your Cursor account.
CURSOR_MODEL=cursor-grok-4.5-high-fast
# CURSOR_REMEDIATION_MODEL=
# CURSOR_VALIDATION_MODEL=
# CURSOR_AGENT_ENDPOINT=https://api2.cursor.sh

# Only for networks that replace public TLS certificates. The PEM is mounted as a BuildKit and
# runtime secret; it is not copied into the repository or Docker build context.
# CURSOR_CA_CERT=/absolute/path/to/corporate-root-ca.crt

CURSOR_AGENT_PORT=8157
CURSOR_MAX_CONCURRENCY=4
CURSOR_MAX_PENDING_JOBS=20
RECOMMEND_TIMEOUT_MS=360000

# Usually leave this unset. Compose reaches the service by Docker DNS; host-side `next dev`
# intentionally falls back to http://localhost:8157.
# RECOMMEND_URL=http://cursor-cli-agent:8157
