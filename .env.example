# Copy to .env and fill in. Never commit .env -- it holds credentials.
#
# Every variable here maps to a ${PLACEHOLDER} in config/verdict.yaml. The split is
# deliberate: the YAML describes behaviour and is safe to commit or mount as a ConfigMap,
# while this file holds only secrets and per-environment endpoints.

# ---- ClickHouse Cloud (required) ----------------------------------------------------------
# From the Cloud console: Connect -> HTTPS. Host has no protocol and no port.
CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=verdict
CLICKHOUSE_SECURE=true

# ---- LLM (optional) -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Narration is the only thing the model does; set
# LLM_ENABLED=false and every computed number in every case file is identical, with prose
# falling back to a template.
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Tracing ------------------------------------------------------------------------------
# Left unset, the app exports to the ClickStack container started by docker compose.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=verdict
HYPERDX_API_KEY=

# ---- Paths --------------------------------------------------------------------------------
# Where ad_events.parquet and the three dimension CSVs live on the host.
DATA_DIR=../hackathon_dataaset/InMobi/data

# ---- Retention ----------------------------------------------------------------------------
# Leave false when analysing a historical dataset. Turning it on applies a 7-day TTL to raw
# events, which for data older than a week means ClickHouse correctly deletes all of it.
RETENTION_ENFORCE=false

# ---- Ports (host side) --------------------------------------------------------------------
HYPERDX_UI_PORT=8080
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
